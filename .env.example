# Copy to .env. Paths are relative to the repository root.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/runtime/cost-tracker.sqlite
DATA_DIR=data/input
PROJECT_ALIASES_PATH=config/project-aliases.json

# Vendor C import. Never put actual credentials in Git.
VENDOR_C_BASE_URL=http://127.0.0.1:4010
VENDOR_C_API_KEY=
VENDOR_C_TIMEOUT_MS=10000
VENDOR_C_MAX_RETRIES=4

# Budget alert webhook. It may contain a token; keep the real value only in .env.
# Leave empty to import without sending alerts.
WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000

# Local proof endpoint used by npm run webhook:mock.
WEBHOOK_MOCK_PORT=4020
WEBHOOK_MOCK_LOG=data/runtime/webhook-received.ndjson
