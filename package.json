{
  "name": "ai-production-cost-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --import tsx src/server/index.ts",
    "dev:web": "vite",
    "db:init": "node --import tsx src/cli/init-db.ts",
    "db:status": "node --import tsx src/cli/db-status.ts",
    "import": "node --import tsx src/cli/import.ts",
    "review:list": "node --import tsx src/cli/review.ts list",
    "review:retry": "node --import tsx src/cli/review.ts retry",
    "alerts:send": "node --import tsx src/cli/alerts.ts send",
    "alerts:status": "node --import tsx src/cli/alerts.ts status",
    "webhook:mock": "node --import tsx src/cli/webhook-mock.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "luxon": "3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
